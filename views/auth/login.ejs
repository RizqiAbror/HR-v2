<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | HRIS Premium</title>
  
  <!-- Tailwind Output -->
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-6 relative overflow-hidden">
  
  <!-- Background Decorations -->
  <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-indigo-100 rounded-full blur-3xl opacity-50"></div>
  <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-96 h-96 bg-blue-100 rounded-full blur-3xl opacity-50"></div>

  <div class="w-full max-w-md relative z-10">
    <!-- Brand Logo Area -->
    <div class="text-center mb-10">
      <div class="w-16 h-16 bg-indigo-600 rounded-2xl flex items-center justify-center shadow-xl shadow-indigo-200 mx-auto mb-4 transform -rotate-6">
        <i data-lucide="layers" class="text-white w-8 h-8"></i>
      </div>
      <h1 class="text-3xl font-black text-slate-800 tracking-tight">HRIS<span class="text-indigo-600">.</span></h1>
      <p class="text-slate-400 font-bold uppercase tracking-[0.2em] text-[10px] mt-1">Premium Employee Portal</p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-[2.5rem] p-10 shadow-2xl shadow-indigo-100/50 border border-white">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-800">Selamat Datang</h2>
        <p class="text-slate-400 text-sm mt-1">Masuk dengan email kantor Anda</p>
      </div>

      <% if (error) { %>
        <div class="bg-rose-50 border border-rose-100 text-rose-600 text-xs font-bold px-4 py-3 rounded-2xl mb-6 flex items-center animate-shake">
          <i data-lucide="alert-circle" class="mr-3 w-5 h-5"></i>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/login" class="space-y-6">
        <div>
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 ml-1">Email Kantor</label>
          <div class="relative">
            <i data-lucide="mail" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
            <input 
              type="email" 
              name="email" 
              class="w-full bg-slate-50 border-transparent rounded-2xl pl-12 pr-4 py-4 text-sm focus:bg-white focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none" 
              placeholder="nama@perusahaan.com"
              required
              autofocus
            >
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 ml-1">Password</label>
          <div class="relative">
            <i data-lucide="shield-check" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
            <input 
              type="password" 
              name="password" 
              class="w-full bg-slate-50 border-transparent rounded-2xl pl-12 pr-4 py-4 text-sm focus:bg-white focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none" 
              placeholder="••••••••"
              required
            >
          </div>
        </div>

        <div class="pt-4">
          <button type="submit" class="w-full bg-indigo-600 text-white font-black py-4 rounded-2xl shadow-xl shadow-indigo-200 hover:bg-indigo-700 hover:-translate-y-1 transition-all duration-300">
            MASUK SEKARANG
          </button>
        </div>
      </form>
    </div>

    <!-- Footer Area -->
    <div class="text-center mt-10">
      <p class="text-slate-400 text-xs font-medium">
        &copy; 2026 Kalapa Technology. All rights reserved.
      </p>
    </div>
  </div>

  <style>
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }
    .animate-shake { animation: shake 0.4s ease-in-out; }
  </style>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
