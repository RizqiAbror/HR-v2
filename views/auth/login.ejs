<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — HR System v2</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #f1f5f9; }
    .login-card { max-width: 400px; width: 100%; border-radius: 12px; }
    .login-brand { font-size: 1.4rem; font-weight: 700; color: #1e293b; }
    .login-subtitle { font-size: 0.875rem; color: #64748b; }
    .btn-login { font-weight: 600; letter-spacing: 0.03em; }
  </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">

  <div class="login-card card shadow-sm p-0">
    <div class="card-header bg-white border-0 text-center pt-4 pb-2">
      <div class="login-brand">&#128188; HR System v2</div>
      <div class="login-subtitle mt-1">Masuk ke sistem</div>
    </div>
    <div class="card-body px-4 pb-4">

      <% if (error) { %>
        <div class="alert alert-danger py-2 small" role="alert">
          <i class="bi bi-exclamation-circle me-1"></i> <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/login">
        <div class="mb-3">
          <label for="email" class="form-label fw-medium small">Email Kantor</label>
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="contoh@kalapa.com"
            required
            autofocus
          >
        </div>
        <div class="mb-4">
          <label for="password" class="form-label fw-medium small">Password</label>
          <input
            type="password"
            class="form-control"
            id="password"
            name="password"
            placeholder="••••••••"
            required
          >
        </div>
        <button type="submit" class="btn btn-primary w-100 btn-login">Masuk</button>
      </form>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
