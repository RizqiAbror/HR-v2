<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-0"><%= pageTitle %></h4>
    <p class="text-muted small mb-0">Catatan aktivitas dan perubahan data sistem</p>
  </div>
</div>

<!-- A. FILTER BAR -->
<div class="card shadow-sm mb-3">
  <div class="card-body py-3">
    <form method="GET" action="/audit-trail" class="row g-2 align-items-center">
      <div class="col-md-3">
        <input type="text" name="nik" class="form-control form-control-sm" placeholder="Filter by NIK..." value="<%= nik || '' %>">
      </div>
      <div class="col-md-3">
        <select name="table" class="form-select form-select-sm">
          <option value="">-- Semua Tabel --</option>
          <option value="employees" <%= tableName === 'employees' ? 'selected' : '' %>>Employees</option>
          <option value="agents" <%= tableName === 'agents' ? 'selected' : '' %>>Agents (Projects)</option>
          <option value="leave_requests" <%= tableName === 'leave_requests' ? 'selected' : '' %>>Leave Requests</option>
          <option value="leave_quotas" <%= tableName === 'leave_quotas' ? 'selected' : '' %>>Leave Quotas</option>
          <option value="national_holidays" <%= tableName === 'national_holidays' ? 'selected' : '' %>>National Holidays</option>
        </select>
      </div>
      <div class="col-md-3">
        <select name="action" class="form-select form-select-sm">
          <option value="">-- Semua Aksi --</option>
          <option value="CREATE" <%= action === 'CREATE' ? 'selected' : '' %>>CREATE</option>
          <option value="UPDATE" <%= action === 'UPDATE' ? 'selected' : '' %>>UPDATE</option>
          <option value="DELETE" <%= action === 'DELETE' ? 'selected' : '' %>>DELETE</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
        <a href="/audit-trail" class="btn btn-sm btn-outline-secondary w-100">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- B. TABEL DATA -->
<div class="card shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0 align-middle font-monospace" style="font-size: 0.85rem;">
        <thead class="table-light">
          <tr>
            <th class="ps-3 py-2">No</th>
            <th>Waktu</th>
            <th>Target (NIK)</th>
            <th>Aktivitas</th>
            <th>Diubah Oleh</th>
            <th class="pe-3 text-center">Detail</th>
          </tr>
        </thead>
        <tbody>
          <% if (logs.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">Belum ada aktivitas terekam</td>
            </tr>
          <% } else { %>
            <% logs.forEach((log, idx) => { %>
              <tr>
                <td class="ps-3"><%= (page - 1) * 50 + idx + 1 %></td>
                <td class="text-nowrap"><%= new Date(log.createdAt).toLocaleString('id-ID') %></td>
                <td>
                  <% if (log.nik) { %>
                    <strong class="text-primary"><%= log.nik %></strong>
                  <% } else { %>
                    <span class="badge bg-light text-dark border">GLOBAL / SISTEM</span>
                  <% } %>
                </td>
                <td>
                  <% 
                    let activity = "";
                    let badgeColor = "secondary";
                    
                    if (log.tableName === 'employees') {
                      activity = log.action === 'CREATE' ? 'Pendaftaran Karyawan Baru' : 'Pembaruan Data Karyawan';
                      badgeColor = log.action === 'CREATE' ? 'success' : 'warning text-dark';
                    } else if (log.tableName === 'agents') {
                      activity = log.action === 'CREATE' ? 'Penambahan Agent/Proyek' : 'Perubahan Nama Agent/Proyek';
                      badgeColor = 'info text-dark';
                    } else if (log.tableName === 'leave_requests') {
                      activity = 'Proses Pengajuan Cuti';
                      badgeColor = 'primary';
                    } else if (log.tableName === 'leave_quotas') {
                      activity = 'Penyesuaian Kuota Cuti';
                      badgeColor = 'dark';
                    } else if (log.tableName === 'national_holidays') {
                      activity = log.action === 'CREATE' ? 'Tambah Libur Nasional' : 'Hapus Libur Nasional';
                      badgeColor = log.action === 'CREATE' ? 'success' : 'danger';
                    } else {
                      activity = `${log.action} pada ${log.tableName}`;
                    }
                  %>
                  <span class="badge bg-<%= badgeColor %> py-1"><%= activity %></span>
                </td>
                <td><%= log.changedBy %></td>
                <td class="pe-3 text-center">
                  <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" 
                          onclick="lihatDetail(this, '<%= log.action %>')"
                          data-old='<%- JSON.stringify(log.oldData || {}).replace(/'/g, "&#39;") %>'
                          data-new='<%- JSON.stringify(log.newData || {}).replace(/'/g, "&#39;") %>'>
                    Lihat
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- D. PAGINATION -->
<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center pagination-sm">
      <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= page - 1 %>&nik=<%= nik || '' %>&table=<%= tableName || '' %>&action=<%= action || '' %>">Prev</a>
      </li>
      <li class="page-item disabled"><span class="page-link">Halaman <%= page %> dari <%= totalPages %></span></li>
      <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= page + 1 %>&nik=<%= nik || '' %>&table=<%= tableName || '' %>&action=<%= action || '' %>">Next</a>
      </li>
    </ul>
  </nav>
<% } %>

<!-- C. MODAL DETAIL (Reusable) -->
<div class="modal fade text-start" id="modalDetail" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title mb-0">Detail Perubahan Data</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0" id="modalContent">
        <!-- Content injected via JS -->
      </div>
    </div>
  </div>
</div>

<!-- E. SCRIPT -->
<script>
  function lihatDetail(btn, action) {
    const oldStr = btn.getAttribute('data-old');
    const newStr = btn.getAttribute('data-new');
    
    let oldData = {};
    let newData = {};
    
    try { oldData = JSON.parse(oldStr || '{}'); } catch(e){}
    try { newData = JSON.parse(newStr || '{}'); } catch(e){}

    const contentDiv = document.getElementById('modalContent');
    let html = '';

    if (action === 'UPDATE') {
      const keys = [...new Set([...Object.keys(oldData), ...Object.keys(newData)])];
      let hasChanges = false;
      let rows = '';

      keys.forEach(key => {
        // Abaikan kolom teknis yang tidak relevan bagi user HR
        const ignoreKeys = ['updatedAt', 'createdAt', 'id'];
        if (ignoreKeys.includes(key)) return;

        let oldVal = oldData[key] !== undefined ? oldData[key] : null;
        let newVal = newData[key] !== undefined ? newData[key] : null;

        if (typeof oldVal === 'object' && oldVal !== null) oldVal = JSON.stringify(oldVal);
        if (typeof newVal === 'object' && newVal !== null) newVal = JSON.stringify(newVal);

        if (oldVal != newVal) {
          hasChanges = true;
          rows += `
            <tr>
              <td><strong>${key}</strong></td>
              <td class="text-danger"><del>${oldVal !== null ? oldVal : '<em>(Kosong)</em>'}</del></td>
              <td class="text-success fw-bold">${newVal !== null ? newVal : '<em>(Dihapus)</em>'}</td>
            </tr>
          `;
        }
      });

      if (!hasChanges) rows = '<tr><td colspan="3" class="text-center text-muted">Tidak ada perubahan terdeteksi</td></tr>';

      html = `
        <table class="table table-sm table-bordered mb-0" style="font-size: 0.85rem;">
          <thead class="table-light"><tr><th width="30%">Kolom</th><th width="35%">Data Lama</th><th width="35%">Data Baru</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
      `;
    } else if (action === 'CREATE') {
      let rows = '';
      Object.keys(newData).forEach(key => {
        let val = newData[key];
        if (typeof val === 'object' && val !== null) val = JSON.stringify(val);
        rows += `<tr><td><strong>${key}</strong></td><td class="text-success">${val}</td></tr>`;
      });
      html = `
        <div class="alert alert-success m-2 py-2" style="font-size: 0.8rem;"><i class="bi bi-plus-circle me-1"></i> Data ditambahkan</div>
        <table class="table table-sm table-bordered mb-0" style="font-size: 0.85rem;">
          <thead class="table-light"><tr><th width="40%">Kolom</th><th>Data Dimasukkan</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
      `;
    } else if (action === 'DELETE') {
      let rows = '';
      Object.keys(oldData).forEach(key => {
        let val = oldData[key];
        if (typeof val === 'object' && val !== null) val = JSON.stringify(val);
        rows += `<tr><td><strong>${key}</strong></td><td class="text-danger"><del>${val}</del></td></tr>`;
      });
      html = `
        <div class="alert alert-danger m-2 py-2" style="font-size: 0.8rem;"><i class="bi bi-trash me-1"></i> Data dihapus dari sistem</div>
        <table class="table table-sm table-bordered mb-0" style="font-size: 0.85rem;">
          <thead class="table-light"><tr><th width="40%">Kolom</th><th>Data yang Dihapus</th></tr></thead>
          <tbody>${rows}</tbody>
        </table>
      `;
    } else {
      // Raw fallback just in case
      html = `
        <div class="p-3">
          <span class="badge bg-secondary mb-2">Raw Data</span>
          <pre class="bg-light p-2 border rounded" style="font-size: 0.8rem;">${JSON.stringify(newData || oldData, null, 2)}</pre>
        </div>
      `;
    }

    contentDiv.innerHTML = html;
    
    // Show Modal
    const myModal = new bootstrap.Modal(document.getElementById('modalDetail'));
    myModal.show();
  }
</script>
