<div class="card shadow-sm">
  <div class="card-header bg-white py-3">
    <h5 class="mb-0 text-primary"><i class="bi bi-shield-lock"></i> Audit Trail - Jejak Digital Perubahan Data</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>Waktu</th>
            <th>Admin</th>
            <th>Aksi</th>
            <th>Tabel</th>
            <th>Deskripsi & Detail Perubahan</th>
          </tr>
        </thead>
        <tbody>
          <% if (logs.length === 0) { %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">Belum ada aktivitas yang tercatat.</td>
            </tr>
          <% } else { %>
            <% logs.forEach(log => { %>
              <tr>
                <td class="text-nowrap"><%= new Date(log.createdAt).toLocaleString('id-ID') %></td>
                <td><span class="badge bg-light text-dark"><%= log.executedBy %></span></td>
                <td>
                  <% if (log.action.includes('IMPORT')) { %>
                    <span class="badge bg-info"><%= log.action %></span>
                  <% } else if (log.action.includes('BULK')) { %>
                    <span class="badge bg-secondary"><%= log.action %></span>
                  <% } else if (log.action.includes('APPROVE') || log.action.includes('UPDATE')) { %>
                    <span class="badge bg-success"><%= log.action %></span>
                  <% } else { %>
                    <span class="badge bg-dark"><%= log.action %></span>
                  <% } %>
                </td>
                <td><code><%= log.tableName %></code></td>
                <td>
                  <div class="fw-bold mb-1"><%= log.description %></div>
                  <% if (log.oldData || log.newData) { %>
                    <div class="mt-2 p-2 bg-light rounded border small">
                      <div class="row">
                        <div class="col-md-6 border-end">
                          <strong class="text-danger">SEBELUM:</strong>
                          <pre class="mb-0" style="font-size: 10px;"><%= JSON.stringify(log.oldData, null, 2) %></pre>
                        </div>
                        <div class="col-md-6">
                          <strong class="text-success">SESUDAH:</strong>
                          <pre class="mb-0" style="font-size: 10px;"><%= JSON.stringify(log.newData, null, 2) %></pre>
                        </div>
                      </div>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
