<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-0"><%= pageTitle %></h4>
    <span class="badge bg-primary"><%= employees.length %> Karyawan</span>
  </div>
  <div class="d-flex gap-2">
    <a href="/api/employee/template" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-download me-1"></i> Download Template
    </a>
    <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalImport">
      <i class="bi bi-upload me-1"></i> Import Excel
    </button>
    <a href="/employee/form" class="btn btn-primary btn-sm">
      <i class="bi bi-person-plus me-1"></i> Tambah Karyawan
    </a>
  </div>
</div>

<!-- FILTER BAR -->
<div class="card shadow-sm mb-4">
  <div class="card-body py-2 px-3">
    <form method="GET" action="/employee" class="row g-2 align-items-center">
      <div class="col-md-4">
        <input type="text" name="search" class="form-control form-control-sm" placeholder="Cari Nama atau NIK..." value="<%= search %>">
      </div>
      <div class="col-md-3">
        <select name="agent" class="form-select form-select-sm">
          <option value="">Semua Agent</option>
          <% agents.forEach(a => { %>
            <option value="<%= a.code %>" <%= agentCode === a.code ? 'selected' : '' %>><%= a.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="/employee" class="btn btn-outline-secondary btn-sm">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- TABEL KARYAWAN -->
<div class="card shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3 py-2">No</th>
            <th>NIK</th>
            <th>Nama Karyawan</th>
            <th>Agent</th>
            <th>Jabatan</th>
            <th class="text-center">Status TK</th>
            <th class="text-center">Status</th>
            <th class="text-center pe-3">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (employees.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">Belum ada data karyawan</td>
            </tr>
          <% } else { %>
            <% employees.forEach((emp, idx) => { %>
              <tr>
                <td class="ps-3"><%= idx + 1 %></td>
                <td><small class="fw-bold"><%= emp.nik %></small></td>
                <td><%= emp.namaKaryawan %></td>
                <td><span class="badge bg-light text-dark border"><%= emp.agent ? emp.agent.code : '-' %></span></td>
                <td><%= emp.jabatan %></td>
                <td class="text-center">
                  <span class="badge bg-<%= emp.statusTk === 'PKWT' ? 'warning text-dark' : 'info' %>">
                    <%= emp.statusTk %>
                  </span>
                </td>
                <td class="text-center">
                  <span class="badge bg-<%= emp.statusKaryawan === 'ACTIVE' ? 'success' : 'secondary' %>">
                    <%= emp.statusKaryawan %>
                  </span>
                </td>
                <td class="text-center pe-3">
                  <a href="/employee/<%= emp.nik %>" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">
                    Detail
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- MODAL IMPORT -->
<div class="modal fade" id="modalImport" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Import Data Karyawan dari Excel</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info py-2" style="font-size: 0.85rem;">
          <i class="bi bi-info-circle me-1"></i> Gunakan template yang tersedia. Kode Agent harus sesuai dengan data di sistem.
        </div>
        <div class="mb-3">
          <label for="fileExcel" class="form-label">Pilih File Excel (.xlsx)</label>
          <input class="form-control" type="file" id="fileExcel" accept=".xlsx">
        </div>
        <div id="hasilImport" class="mt-3" style="display: none;">
          <!-- Hasil akan muncul di sini -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-primary" id="btnImport">Upload & Import</button>
      </div>
    </div>
  </div>
</div>

<script>
  const btnImport = document.getElementById('btnImport');
  const fileExcel = document.getElementById('fileExcel');
  const hasilImport = document.getElementById('hasilImport');

  btnImport.addEventListener('click', async () => {
    if (!fileExcel.files[0]) {
      alert('Pilih file excel dulu!');
      return;
    }

    const formData = new FormData();
    formData.append('file', fileExcel.files[0]);

    try {
      btnImport.disabled = true;
      btnImport.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Memproses...';
      
      const response = await fetch('/api/employee/import', {
        method: 'POST',
        body: formData
      });
      
      const res = await response.json();
      
      if (res.success) {
        const d = res.data;
        let html = `
          <div class="alert alert-success py-2">
            <strong>Selesai!</strong><br>
            ✅ Berhasil: ${d.berhasil} | 🔄 Diperbarui: ${d.diperbarui} | ❌ Gagal: ${d.gagal}
          </div>
        `;
        
        if (d.errors.length > 0) {
          html += `<div class="text-danger mt-2" style="font-size: 0.8rem;">
            <strong>Daftar Error:</strong>
            <ul class="mb-0 ps-3">
              ${d.errors.map(e => `<li>${e}</li>`).join('')}
            </ul>
          </div>`;
        }
        
        html += `<button class="btn btn-sm btn-dark mt-3 w-100" onclick="window.location.reload()">Tutup & Refresh</button>`;
        
        hasilImport.innerHTML = html;
        hasilImport.style.display = 'block';
        btnImport.style.display = 'none';
      } else {
        alert('Gagal: ' + res.message);
        btnImport.disabled = false;
        btnImport.innerHTML = 'Upload & Import';
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
      btnImport.disabled = false;
      btnImport.innerHTML = 'Upload & Import';
    }
  });
</script>
