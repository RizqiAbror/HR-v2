<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h2 class="text-3xl font-extrabold text-slate-800 tracking-tight">Data Karyawan</h2>
    <p class="text-slate-500 mt-1 font-medium">Manajemen seluruh data personel di dalam sistem.</p>
  </div>
  <div class="flex items-center gap-3">
    <a href="/api/employee/template" class="hris-btn-outline flex items-center py-2.5">
      <i data-lucide="download" class="mr-2 w-5 h-5"></i> Template
    </a>
    <button class="hris-btn-outline flex items-center py-2.5" onclick="document.getElementById('modalImport').classList.remove('hidden')">
      <i data-lucide="upload" class="mr-2 w-5 h-5"></i> Import
    </button>
    <a href="/employee/form" class="hris-btn-primary flex items-center py-2.5">
      <i data-lucide="user-plus" class="mr-2 w-5 h-5"></i> Tambah Baru
    </a>
  </div>
</div>

<!-- FILTER BAR -->
<div class="hris-card mb-8">
  <form method="GET" action="/employee" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
    <div class="md:col-span-5">
      <label class="hris-label">Cari Karyawan</label>
      <div class="relative">
        <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
        <input type="text" name="search" class="hris-input pl-11" placeholder="Ketik Nama atau NIK..." value="<%= search %>">
      </div>
    </div>
    <div class="md:col-span-4">
      <label class="hris-label">Filter Agent</label>
      <select name="agent" class="hris-input appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22m6%208%204%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem_1.25rem] bg-[right_0.5rem_center] bg-no-repeat">
        <option value="">Semua Agent</option>
        <% agents.forEach(a => { %>
          <option value="<%= a.code %>" <%= agentCode === a.code ? 'selected' : '' %>><%= a.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="md:col-span-3 flex gap-2">
      <button type="submit" class="hris-btn-primary w-full py-2.5">Filter</button>
      <a href="/employee" class="hris-btn-outline w-full py-2.5 text-center">Reset</a>
    </div>
  </form>
</div>

<!-- DATA TABLE -->
<div class="hris-table-container">
  <table class="hris-table">
    <thead>
      <tr>
        <th class="w-16">No</th>
        <th>Informasi Karyawan</th>
        <th>Jabatan & Agent</th>
        <th class="text-center">Status TK</th>
        <th class="text-center text-nowrap">Status Kerja</th>
        <th class="text-right">Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% if (employees.length === 0) { %>
        <tr>
          <td colspan="6" class="text-center py-20">
            <div class="flex flex-col items-center opacity-40">
              <i data-lucide="inbox" class="w-12 h-12"></i>
              <p class="mt-2 font-bold uppercase tracking-widest text-xs">Belum ada data</p>
            </div>
          </td>
        </tr>
      <% } else { %>
        <% employees.forEach((emp, idx) => { %>
          <tr class="group">
            <td class="font-bold text-slate-300"><%= idx + 1 %></td>
            <td>
              <div class="flex flex-col">
                <span class="font-bold text-slate-800"><%= emp.namaKaryawan %></span>
                <span class="text-[11px] font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded w-fit mt-1"><%= emp.nik %></span>
              </div>
            </td>
            <td>
              <div class="flex flex-col">
                <span class="font-medium"><%= emp.jabatan %></span>
                <span class="text-xs text-slate-400"><%= emp.agent ? emp.agent.name : '-' %></span>
              </div>
            </td>
            <td class="text-center">
              <span class="hris-badge <%= emp.statusTk === 'PKWT' ? 'bg-amber-50 text-amber-600' : 'bg-blue-50 text-blue-600' %>">
                <%= emp.statusTk %>
              </span>
            </td>
            <td class="text-center">
              <span class="hris-badge <%= emp.statusKaryawan === 'ACTIVE' ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>">
                <%= emp.statusKaryawan %>
              </span>
            </td>
            <td class="text-right">
              <a href="/employee/<%= emp.nik %>" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 font-bold text-xs uppercase tracking-wider group-hover:mr-2 transition-all">
                Detail <i data-lucide="chevron-right" class="ml-1 w-4 h-4"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- MODAL IMPORT (Custom Tailwind) -->
<div id="modalImport" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-[2rem] w-full max-w-lg shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-300">
    <div class="px-8 py-6 border-b border-slate-100 flex justify-between items-center">
      <h5 class="text-xl font-bold text-slate-800">Import Karyawan</h5>
      <button onclick="document.getElementById('modalImport').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
    </div>
    <div class="p-8">
      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 mb-6 flex items-start">
        <i data-lucide="info" class="text-blue-500 mt-0.5 w-5 h-5"></i>
        <div class="ml-3 text-xs text-blue-700 leading-relaxed font-medium">
          Gunakan template Excel yang tersedia. Sistem akan melakukan <strong>Upsert</strong> (Update jika email sudah ada, Insert jika baru).
        </div>
      </div>
      
      <div class="space-y-4">
        <div>
          <label class="hris-label">File Excel (.xlsx)</label>
          <input type="file" id="fileExcel" accept=".xlsx" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer border border-slate-100 rounded-xl p-2 bg-slate-50">
        </div>
        
        <div id="hasilImport" class="hidden"></div>
      </div>
    </div>
    <div class="px-8 py-6 bg-slate-50 flex justify-end gap-3">
      <button onclick="document.getElementById('modalImport').classList.add('hidden')" class="text-sm font-bold text-slate-400 px-6 py-2">Batal</button>
      <button id="btnImport" class="hris-btn-primary py-2 px-8">Upload Sekarang</button>
    </div>
  </div>
</div>

<script>
  // Script tetap sama fungsinya tapi disesuaikan UI-nya
  const btnImport = document.getElementById('btnImport');
  const fileExcel = document.getElementById('fileExcel');
  const hasilImport = document.getElementById('hasilImport');
  const modalImport = document.getElementById('modalImport');

  btnImport.addEventListener('click', async () => {
    if (!fileExcel.files[0]) {
      alert('Pilih file excel dulu!');
      return;
    }

    const formData = new FormData();
    formData.append('file', fileExcel.files[0]);

    try {
      btnImport.disabled = true;
      btnImport.innerHTML = '<span class="animate-spin inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full mr-2"></span> Proses...';
      
      const response = await fetch('/api/employee/import', {
        method: 'POST',
        body: formData
      });
      
      const res = await response.json();
      
      if (res.success) {
        const d = res.data;
        let html = `
          <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-4 text-emerald-800 text-sm">
            <p class="font-bold mb-2">Import Berhasil!</p>
            <div class="flex gap-4 text-xs">
              <span>✅ Baru: <strong>${d.berhasil}</strong></span>
              <span>🔄 Update: <strong>${d.diperbarui}</strong></span>
              <span>❌ Gagal: <strong>${d.gagal}</strong></span>
            </div>
          </div>
        `;
        
        if (d.errors.length > 0) {
          html += `<div class="mt-4 max-h-32 overflow-y-auto bg-rose-50 p-3 rounded-xl border border-rose-100">
            <p class="text-[10px] font-bold text-rose-600 uppercase mb-2">Daftar Error:</p>
            <ul class="text-[10px] text-rose-500 space-y-1">
              ${d.errors.map(e => `<li>• ${e}</li>`).join('')}
            </ul>
          </div>`;
        }
        
        html += `<button class="hris-btn-primary w-full mt-6 py-2" onclick="window.location.reload()">Tutup & Refresh</button>`;
        
        hasilImport.innerHTML = html;
        hasilImport.classList.remove('hidden');
        btnImport.style.display = 'none';
      } else {
        alert('Gagal: ' + res.message);
        btnImport.disabled = false;
        btnImport.innerHTML = 'Upload Sekarang';
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
      btnImport.disabled = false;
      btnImport.innerHTML = 'Upload Sekarang';
    }
  });
</script>
