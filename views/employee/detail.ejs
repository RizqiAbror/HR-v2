<div class="flex items-center gap-2 mb-6 text-xs font-bold uppercase tracking-widest text-slate-400">
  <a href="/employee" class="hover:text-indigo-600 transition-colors">Data Karyawan</a>
  <i data-lucide="chevron-right" class="w-3 h-3"></i>
  <span class="text-slate-800"><%= employee.namaKaryawan %></span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- LEFT COLUMN: MAIN INFO -->
  <div class="lg:col-span-8 space-y-8">
    
    <!-- Profile Header Card -->
    <div class="hris-card relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-50 rounded-full -mr-16 -mt-16 opacity-50"></div>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-indigo-600 rounded-3xl flex items-center justify-center text-white text-3xl font-black shadow-xl shadow-indigo-100">
            <%= employee.namaKaryawan.charAt(0) %>
          </div>
          <div>
            <h1 class="text-3xl font-black text-slate-800 tracking-tight"><%= employee.namaKaryawan %></h1>
            <div class="flex items-center gap-3 mt-1">
              <span class="text-indigo-600 font-bold tracking-wider text-sm"><%= employee.nik %></span>
              <span class="w-1 h-1 rounded-full bg-slate-300"></span>
              <span class="text-slate-500 font-medium text-sm"><%= employee.jabatan %></span>
            </div>
          </div>
        </div>
        <div class="flex gap-3">
          <a href="/employee/<%= employee.nik %>/edit" class="hris-btn-outline py-2.5">
            <i data-lucide="edit" class="mr-2 w-4 h-4"></i> Edit Profil
          </a>
        </div>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10 pt-8 border-t border-slate-100">
        <div>
          <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status TK</p>
          <p class="mt-1"><span class="hris-badge bg-indigo-50 text-indigo-600"><%= employee.statusTk %></span></p>
        </div>
        <div>
          <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Status Kerja</p>
          <p class="mt-1"><span class="hris-badge <%= employee.statusKaryawan === 'ACTIVE' ? 'bg-emerald-50 text-emerald-600' : 'bg-slate-100 text-slate-500' %>"><%= employee.statusKaryawan %></span></p>
        </div>
        <div>
          <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Joint Date</p>
          <p class="mt-1 text-sm font-bold text-slate-700"><%= new Date(employee.jointDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Agent</p>
          <p class="mt-1 text-sm font-bold text-slate-700"><%= employee.agent ? employee.agent.name : '-' %></p>
        </div>
      </div>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Data Personal -->
      <div class="hris-card">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <i data-lucide="contact" class="w-4 h-4"></i>
          </div>
          <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest">Data Personal</h3>
        </div>
        <div class="space-y-4">
          <div class="flex justify-between pb-3 border-b border-slate-50">
            <span class="text-xs text-slate-400">Nomor KTP</span>
            <span class="text-sm font-bold text-slate-700"><%= employee.nomorKtp || '-' %></span>
          </div>
          <div class="flex justify-between pb-3 border-b border-slate-50">
            <span class="text-xs text-slate-400">NPWP</span>
            <span class="text-sm font-bold text-slate-700"><%= employee.npwp || '-' %></span>
          </div>
          <div class="flex justify-between pb-3 border-b border-slate-50">
            <span class="text-xs text-slate-400">Status Perkawinan</span>
            <span class="text-sm font-bold text-slate-700"><%= employee.statusPerkawinan || '-' %></span>
          </div>
          <div class="flex justify-between pb-3 border-b border-slate-50">
            <span class="text-xs text-slate-400">Email Pribadi</span>
            <span class="text-sm font-bold text-slate-700"><%= employee.emailPribadi || '-' %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-xs text-slate-400">Email Kantor</span>
            <span class="text-sm font-bold text-indigo-600"><%= employee.emailKantor %></span>
          </div>
        </div>
      </div>

      <!-- Data Payroll -->
      <div class="hris-card">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
            <i data-lucide="banknote" class="w-4 h-4"></i>
          </div>
          <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest">Payroll & Bank</h3>
        </div>
        <div class="space-y-4">
          <div class="flex justify-between pb-3 border-b border-slate-50">
            <span class="text-xs text-slate-400">Nama Bank</span>
            <span class="text-sm font-bold text-slate-700"><%= employee.namaBank || '-' %></span>
          </div>
          <div class="flex justify-between pb-3 border-b border-slate-50">
            <span class="text-xs text-slate-400">No Rekening</span>
            <span class="text-sm font-bold text-slate-700"><%= employee.noRekening || '-' %></span>
          </div>
          <div class="flex justify-between pb-3 border-b border-slate-50">
            <span class="text-xs text-slate-400">Atas Nama</span>
            <span class="text-sm font-bold text-slate-700"><%= employee.namaRekening || '-' %></span>
          </div>
          <div class="p-4 bg-emerald-50 rounded-2xl mt-4">
            <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">Gaji Pokok</p>
            <p class="text-xl font-black text-emerald-700">Rp <%= employee.gajiPokok.toLocaleString('id-ID') %></p>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- RIGHT COLUMN: WIDGETS -->
  <div class="lg:col-span-4 space-y-8">
    
    <!-- Leave Quota Widget -->
    <div class="hris-card">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <i data-lucide="calendar-range" class="w-4 h-4"></i>
          </div>
          <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest">Kuota Cuti</h3>
        </div>
        <a href="/cuti/form?nik=<%= employee.nik %>" class="text-[10px] font-black text-indigo-600 hover:underline">INPUT CUTI</a>
      </div>
      
      <div class="space-y-3">
        <% employee.leaveQuotas.forEach(q => { %>
          <% const sisa = q.jumlahCuti - q.cutiTerpakai; %>
          <div class="flex items-center justify-between p-3 rounded-xl border border-slate-50 bg-slate-50/50">
            <div>
              <p class="text-xs font-bold text-slate-700">Tahun <%= q.tahun %></p>
              <p class="text-[10px] text-slate-400">Jatah: <%= q.jumlahCuti %> hari</p>
            </div>
            <div class="text-right">
              <p class="text-lg font-black <%= sisa > 0 ? 'text-emerald-600' : 'text-rose-600' %>"><%= sisa %></p>
              <p class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Sisa Hari</p>
            </div>
          </div>
        <% }) %>
      </div>
      <a href="/cuti/riwayat/<%= employee.nik %>" class="block text-center mt-6 text-xs font-bold text-slate-400 hover:text-indigo-600 transition-colors uppercase tracking-widest">Lihat Riwayat Lengkap</a>
    </div>

    <!-- PKWT Widget -->
    <div class="hris-card">
      <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest mb-6">Attachment PKWT</h3>
      
      <% if (employee.pkwtAttachmentUrl) { %>
        <a href="<%= employee.pkwtAttachmentUrl %>" target="_blank" class="flex items-center justify-between p-4 rounded-2xl bg-slate-900 text-white mb-6 group transition-all hover:bg-indigo-600">
          <div class="flex items-center gap-3">
            <i data-lucide="file-text" class="w-8 h-8 text-rose-400"></i>
            <div>
              <p class="text-xs font-bold">Dokumen PKWT</p>
              <p class="text-[10px] text-white/50">Klik untuk melihat PDF</p>
            </div>
          </div>
          <i data-lucide="external-link" class="text-white/30 group-hover:text-white transition-colors w-4 h-4"></i>
        </a>
      <% } else { %>
        <div class="p-8 rounded-2xl border-2 border-dashed border-slate-100 text-center mb-6">
          <i data-lucide="file-warning" class="w-10 h-10 text-slate-200 mx-auto"></i>
          <p class="text-xs text-slate-400 font-medium mt-2">Belum ada dokumen diupload</p>
        </div>
      <% } %>

      <form id="formPkwt" class="space-y-4">
        <div class="relative">
          <input type="file" id="pkwtFile" class="hidden" accept=".pdf,image/*">
          <label for="pkwtFile" class="flex items-center justify-center w-full py-3 px-4 border border-slate-200 rounded-xl text-xs font-bold text-slate-600 cursor-pointer hover:bg-slate-50 transition-all">
            <i data-lucide="upload-cloud" class="mr-2 w-4 h-4"></i> Pilih File Baru
          </label>
        </div>
        <button type="submit" id="btnPkwt" class="hris-btn-primary w-full py-3">Upload Sekarang</button>
      </form>
    </div>

  </div>
</div>

<script>
  const formPkwt = document.getElementById('formPkwt');
  const btnPkwt = document.getElementById('btnPkwt');
  const pkwtFile = document.getElementById('pkwtFile');

  formPkwt.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!pkwtFile.files[0]) {
      alert('Pilih file terlebih dahulu!');
      return;
    }

    const formData = new FormData();
    formData.append('pkwt', pkwtFile.files[0]);

    try {
      btnPkwt.disabled = true;
      btnPkwt.innerHTML = '<span class="animate-spin inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full mr-2"></span> Uploading...';
      
      const response = await fetch('/api/employee/<%= employee.nik %>/pkwt', {
        method: 'POST',
        body: formData
      });
      
      const res = await response.json();
      if (res.success) {
        window.location.reload();
      } else {
        alert('Gagal: ' + res.message);
        btnPkwt.disabled = false;
        btnPkwt.innerHTML = 'Upload Sekarang';
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
      btnPkwt.disabled = false;
      btnPkwt.innerHTML = 'Upload Sekarang';
    }
  });

  // Display filename when selected
  pkwtFile.addEventListener('change', function() {
    if (this.files[0]) {
      const label = document.querySelector('label[for="pkwtFile"]');
      label.innerHTML = `<i data-lucide="check-circle-2" class="mr-2 text-emerald-500 w-4 h-4"></i> ${this.files[0].name}`;
      lucide.createIcons();
    }
  });
</script>
