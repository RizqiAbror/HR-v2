<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h2 class="text-3xl font-extrabold text-slate-800 tracking-tight">Libur Nasional</h2>
    <p class="text-slate-500 mt-1 font-medium">Pengaturan hari libur resmi untuk perhitungan jatah cuti otomatis.</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- FORM TAMBAH (Col 4) -->
  <div class="lg:col-span-4">
    <div class="hris-card sticky top-8 shadow-2xl shadow-slate-200/50">
      <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest mb-6">Tambah Hari Libur</h3>
      <form id="formLibur" class="space-y-5">
        <div>
          <label class="hris-label">Tanggal Libur</label>
          <input type="date" name="tanggal" class="hris-input" required>
        </div>
        <div>
          <label class="hris-label">Keterangan</label>
          <input type="text" name="keterangan" class="hris-input" placeholder="Contoh: Idul Fitri" required>
        </div>
        <button type="submit" id="btnSave" class="hris-btn-primary w-full py-3 mt-4">
          <i data-lucide="plus" class="mr-2 w-5 h-5"></i> Simpan Libur
        </button>
      </form>
    </div>
  </div>

  <!-- DAFTAR LIBUR (Col 8) -->
  <div class="lg:col-span-8">
    <div class="hris-table-container">
      <div class="px-8 py-5 border-b border-slate-50 flex justify-between items-center bg-slate-50/30">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Daftar Hari Libur Tahun <%= new Date().getFullYear() %></h4>
      </div>
      <table class="hris-table">
        <thead>
          <tr>
            <th class="w-16">No</th>
            <th>Tanggal</th>
            <th>Keterangan</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (holidays.length === 0) { %>
            <tr>
              <td colspan="4" class="text-center py-20 text-slate-400 italic">Belum ada hari libur terdaftar</td>
            </tr>
          <% } else { %>
            <% holidays.forEach((h, idx) => { %>
              <tr class="group">
                <td class="text-slate-300 font-bold"><%= idx + 1 %></td>
                <td>
                  <div class="flex items-center text-slate-700 font-bold">
                    <i data-lucide="calendar-days" class="mr-3 text-rose-400 w-5 h-5"></i>
                    <%= new Date(h.tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                  </div>
                </td>
                <td>
                  <span class="text-sm text-slate-600 font-medium"><%= h.keterangan %></span>
                </td>
                <td class="text-right">
                  <button onclick="deleteLibur('<%= h.id %>')" class="w-8 h-8 flex items-center justify-center rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white transition-all opacity-0 group-hover:opacity-100">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('formLibur');
  const btnSave = document.getElementById('btnSave');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      btnSave.disabled = true;
      btnSave.innerHTML = '<span class="animate-spin inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full mr-2"></span> Menyimpan...';
      
      const res = await fetch('/api/libur-nasional', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message);
        btnSave.disabled = false;
        btnSave.innerHTML = '<i data-lucide="plus" class="mr-2 w-5 h-5"></i> Simpan Libur';
        lucide.createIcons();
      }
    } catch (err) {
      alert('Gagal menyimpan');
      btnSave.disabled = false;
      btnSave.innerHTML = '<i data-lucide="plus" class="mr-2 w-5 h-5"></i> Simpan Libur';
      lucide.createIcons();
    }
  });

  async function deleteLibur(id) {
    if (!confirm('Hapus hari libur ini?')) return;
    try {
      const res = await fetch(`/api/libur-nasional/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) window.location.reload();
    } catch (err) { alert('Gagal menghapus'); }
  }
</script>
