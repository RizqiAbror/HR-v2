<div class="row mb-4">
  <div class="col-md-3">
    <div class="card text-white bg-primary mb-3 shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Cuti Hari Ini</h5>
        <h2 class="mb-0"><%= dashboardStats.onLeaveToday %></h2>
        <small>Karyawan Sedang Libur</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-white bg-warning mb-3 shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title text-dark">Menunggu Persetujuan</h5>
        <h2 class="mb-0 text-dark"><%= stats.totalPending %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-white bg-success mb-3 shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Disetujui Tahun Ini</h5>
        <h2 class="mb-0"><%= stats.totalApproved %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-white bg-danger mb-3 shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Ditolak Tahun Ini</h5>
        <h2 class="mb-0"><%= stats.totalRejected %></h2>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-8">
    <div class="card shadow-sm h-100">
  <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
    <h5 class="mb-0">Daftar Pengajuan Aktif</h5>
    <div>
      <button type="button" class="btn btn-info btn-sm text-white me-2" data-bs-toggle="modal" data-bs-target="#modalImportEmployee">
        <i class="bi bi-upload"></i> Import Karyawan
      </button>
      <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#modalBulkLeave">
        <i class="bi bi-calendar2-check"></i> Tambah Cuti Bersama
      </button>
      <a href="/cuti/form?nik=KTP_25_01_001" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Ajukan Cuti (Test Karyawan)</a>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>No</th>
            <th>Request No</th>
            <th>NIK</th>
            <th>Nama Karyawan</th>
            <th>Tgl Mulai</th>
            <th>Tgl Akhir</th>
            <th>Jml Hari</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center py-4">Tidak ada pengajuan aktif</td>
            </tr>
          <% } else { %>
            <% requests.forEach((req, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= req.requestNo %></td>
                <td><%= req.nik %></td>
                <td><%= req.employee ? req.employee.namaKaryawan : '-' %></td>
                <td><%= new Date(req.tanggalMulai).toLocaleDateString('id-ID') %></td>
                <td><%= new Date(req.tanggalAkhir).toLocaleDateString('id-ID') %></td>
                <td><%= req.jumlahHari %></td>
                <td>
                  <% if (req.status === 'PENDING_ATASAN') { %>
                    <span class="badge bg-warning text-dark"><%= req.status %></span>
                  <% } else if (req.status === 'PENDING_HR') { %>
                    <span class="badge bg-info text-dark"><%= req.status %></span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= req.status %></span>
                  <% } %>
                </td>
                <td>
                  <% if (req.status === 'PENDING_ATASAN') { %>
                    <!-- Anggap /cuti/:id belum dibuat, kita beri link placeholder -->
                    <a href="#" class="btn btn-sm btn-outline-secondary">Lihat</a>
                  <% } else if (req.status === 'PENDING_HR') { %>
                    <button class="btn btn-sm btn-success" data-id="<%= req.id %>" onclick="approveHR('<%= req.id %>')">Approve</button>
                    <button class="btn btn-sm btn-danger" data-id="<%= req.id %>" onclick="rejectHR('<%= req.id %>')">Reject</button>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white py-3">
        <h5 class="mb-0"><i class="bi bi-graph-up"></i> Top Agent Cuti (Bulan Ini)</h5>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm table-striped mb-0">
          <thead class="table-light">
            <tr>
              <th>Agent</th>
              <th class="text-end">Frekuensi</th>
            </tr>
          </thead>
          <tbody>
            <% if (dashboardStats.topAgents.length === 0) { %>
              <tr><td colspan="2" class="text-center py-3 text-muted">Belum ada data</td></tr>
            <% } else { %>
              <% dashboardStats.topAgents.forEach(item => { %>
                <tr>
                  <td><%= item.agentName %></td>
                  <td class="text-end fw-bold"><%= item.totalCuti %> kali</td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm mt-4">
  <div class="card-header bg-white py-3">
    <h5 class="mb-0">Riwayat Penggunaan Cuti</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>No</th>
            <th>Request No</th>
            <th>NIK</th>
            <th>Nama Karyawan</th>
            <th>Tgl Mulai</th>
            <th>Tgl Akhir</th>
            <th>Jml Hari</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (historyRequests && historyRequests.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-4">Belum ada riwayat cuti</td>
            </tr>
          <% } else if (historyRequests) { %>
            <% historyRequests.forEach((req, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= req.requestNo %></td>
                <td><%= req.nik %></td>
                <td><%= req.employee ? req.employee.namaKaryawan : '-' %></td>
                <td><%= new Date(req.tanggalMulai).toLocaleDateString('id-ID') %></td>
                <td><%= new Date(req.tanggalAkhir).toLocaleDateString('id-ID') %></td>
                <td><%= req.jumlahHari %></td>
                <td>
                  <% if (req.status === 'APPROVED') { %>
                    <span class="badge bg-success"><%= req.status %></span>
                  <% } else if (req.status === 'REJECTED') { %>
                    <span class="badge bg-danger"><%= req.status %></span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= req.status %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Bulk Leave -->
<div class="modal fade" id="modalBulkLeave" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Tambah Cuti Bersama</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="formBulkLeave">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tanggal Cuti Bersama</label>
            <input type="date" class="form-control" id="bulkTanggal" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Pilih Agent / Klien</label>
            <select class="form-select" id="bulkAgent" required>
              <option value="">-- Pilih Agent --</option>
              <% if (typeof agents !== 'undefined') { %>
                <% agents.forEach(agent => { %>
                  <option value="<%= agent.id %>"><%= agent.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Keterangan</label>
            <input type="text" class="form-control" id="bulkKeterangan" placeholder="Contoh: Idul Fitri" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-primary" id="btnSubmitBulk">Proses Cuti Massal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Import Employee -->
<div class="modal fade" id="modalImportEmployee" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Import Data Karyawan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="formImportEmployee">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">File Excel (.xlsx) atau CSV (.csv)</label>
            <input type="file" class="form-control" id="fileImport" accept=".xlsx, .csv" required>
            <small class="text-muted">Format kolom: NIK, Nama, Agent, Jabatan, Status, Gaji Pokok, Allowance</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-primary" id="btnSubmitImport">Upload & Proses</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  async function approveHR(id) {
    if (!confirm('Setujui pengajuan ini?')) return;
    
    try {
      const response = await fetch(`/api/cuti/approve/${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          action: 'APPROVE',
          role: 'HR',
          approvedBy: 'HR_ADMIN'
        })
      });
      
      const data = await response.json();
      if (data.success) {
        alert('Berhasil disetujui');
        window.location.reload();
      } else {
        alert('Gagal: ' + data.message);
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
    }
  }

  async function rejectHR(id) {
    const alasan = prompt('Masukkan alasan penolakan:');
    if (!alasan) return;
    
    try {
      const response = await fetch(`/api/cuti/approve/${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          action: 'REJECT',
          role: 'HR',
          approvedBy: 'HR_ADMIN',
          catatan: alasan
        })
      });
      
      const data = await response.json();
      if (data.success) {
        alert('Pengajuan ditolak');
        window.location.reload();
      } else {
        alert('Gagal: ' + data.message);
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
    }
  }

  document.getElementById('formBulkLeave')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitBulk');
    btn.disabled = true;
    btn.innerHTML = 'Memproses...';

    const payload = {
      tanggal: document.getElementById('bulkTanggal').value,
      agentId: document.getElementById('bulkAgent').value,
      keterangan: document.getElementById('bulkKeterangan').value,
      adminNik: 'HR_BU_YOLA' // Hardcode simulasi Admin
    };

    try {
      const response = await fetch('/api/cuti/bulk-submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await response.json();
      if (data.success) {
        alert('Cuti bersama berhasil diaplikasikan!');
        window.location.reload();
      } else {
        alert('Gagal: ' + data.message);
        btn.disabled = false;
        btn.innerHTML = 'Proses Cuti Massal';
      }
    } catch (err) {
      alert('Terjadi kesalahan sistem');
      btn.disabled = false;
      btn.innerHTML = 'Proses Cuti Massal';
    }
  });

  document.getElementById('formImportEmployee')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitImport');
    btn.disabled = true;
    btn.innerHTML = 'Mengupload...';

    const formData = new FormData();
    formData.append('file', document.getElementById('fileImport').files[0]);
    formData.append('adminNik', 'HR_BU_YOLA'); // Simulasi Admin

    try {
      const response = await fetch('/api/employees/import', {
        method: 'POST',
        body: formData
      });
      const data = await response.json();
      if (data.success) {
        alert(data.message);
        window.location.reload();
      } else {
        alert('Gagal: ' + data.message);
        btn.disabled = false;
        btn.innerHTML = 'Upload & Proses';
      }
    } catch (err) {
      alert('Terjadi kesalahan sistem saat upload');
      btn.disabled = false;
      btn.innerHTML = 'Upload & Proses';
    }
  });
</script>
