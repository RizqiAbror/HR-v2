<div class="row mb-4">
  <div class="col-md-4">
    <div class="card text-white bg-warning mb-3 shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title text-dark">Menunggu Persetujuan</h5>
        <h2 class="mb-0 text-dark"><%= stats.totalPending %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-white bg-success mb-3 shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Disetujui Tahun Ini</h5>
        <h2 class="mb-0"><%= stats.totalApproved %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-white bg-danger mb-3 shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Ditolak Tahun Ini</h5>
        <h2 class="mb-0"><%= stats.totalRejected %></h2>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
    <h5 class="mb-0">Daftar Pengajuan Aktif</h5>
    <a href="/cuti/form" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Input Pengajuan Cuti</a>
  </div>
  <div class="card-body p-0">
    <div class="px-3 pt-3">
      <a href="/cuti/form" class="btn btn-primary mb-3">+ Input Pengajuan Cuti</a>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3 py-2">No</th>
            <th>Request No</th>
            <th>NIK</th>
            <th>Nama Karyawan</th>
            <th>Agent</th>
            <th>Tgl Mulai</th>
            <th>Tgl Akhir</th>
            <th>Hari</th>
            <th>Status</th>
            <th class="pe-3 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr>
              <td colspan="10" class="text-center py-4">Tidak ada pengajuan aktif</td>
            </tr>
          <% } else { %>
            <% requests.forEach((req, index) => { %>
              <tr>
                <td class="ps-3"><%= index + 1 %></td>
                <td><small><strong><%= req.requestNo %></strong></small></td>
                <td><%= req.nik %></td>
                <td><%= req.employee ? req.employee.namaKaryawan : '-' %></td>
                <td><span class="badge bg-light text-dark border"><%= (req.employee && req.employee.agent) ? req.employee.agent.code : '-' %></span></td>
                <td><%= new Date(req.tanggalMulai).toLocaleDateString('id-ID') %></td>
                <td><%= new Date(req.tanggalAkhir).toLocaleDateString('id-ID') %></td>
                <td><%= req.jumlahHari %></td>
                <td>
                  <% if (req.status === 'PENDING_HR') { %>
                    <span class="badge bg-warning text-dark"><%= req.status %></span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= req.status %></span>
                  <% } %>
                </td>
                <td class="pe-3 text-center">
                  <% if (req.status === 'PENDING_HR') { %>
                    <button class="btn btn-sm btn-success py-0 px-2" style="font-size: 0.8rem;" onclick="approveHR('<%= req.id %>')">Approve ✓</button>
                    <button class="btn btn-sm btn-danger py-0 px-2" style="font-size: 0.8rem;" onclick="rejectHR('<%= req.id %>')">Reject ✗</button>
                  <% } else { %>
                    <a href="/cuti/<%= req.id %>" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">Detail</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  async function approveHR(id) {
    if (!confirm('Setujui pengajuan ini?')) return;
    
    try {
      const response = await fetch(`/api/cuti/approve/${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          action: 'APPROVE',
          approvedBy: 'HR_ADMIN_YOLA'
        })
      });
      
      const data = await response.json();
      if (data.success) {
        alert('Berhasil disetujui');
        window.location.reload();
      } else {
        alert('Gagal: ' + data.message);
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
    }
  }

  async function rejectHR(id) {
    const alasan = prompt('Masukkan alasan penolakan:');
    if (!alasan) return;
    
    try {
      const response = await fetch(`/api/cuti/approve/${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          action: 'REJECT',
          approvedBy: 'HR_ADMIN_YOLA',
          catatan: alasan
        })
      });
      
      const data = await response.json();
      if (data.success) {
        alert('Pengajuan ditolak');
        window.location.reload();
      } else {
        alert('Gagal: ' + data.message);
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
    }
  }
</script>
