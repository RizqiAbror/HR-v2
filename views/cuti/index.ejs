<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
  <div>
    <h2 class="text-3xl font-extrabold text-slate-800 tracking-tight">Manajemen Cuti</h2>
    <p class="text-slate-500 mt-1 font-medium">Log seluruh pengajuan cuti — input terbaru tampil paling atas.</p>
  </div>
  <div class="flex items-center gap-3">
    <button onclick="document.getElementById('modalCutiBersama').classList.remove('hidden')" class="bg-rose-50 text-rose-600 hover:bg-rose-100 hover:text-rose-700 px-4 py-2.5 rounded-xl font-bold text-sm transition-all flex items-center shadow-sm border border-rose-100">
      <i data-lucide="calendar-off" class="mr-2 w-4 h-4"></i> Potong Cuti Bersama
    </button>
    <a href="/cuti/form" class="hris-btn-primary flex items-center py-2.5 shrink-0">
      <i data-lucide="file-plus" class="mr-2 w-5 h-5"></i> Input Surat Cuti
    </a>
  </div>
</div>

<!-- STAT CARDS -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <a href="/cuti" class="hris-card flex items-center gap-5 hover:border-slate-200 hover:-translate-y-1 transition-all cursor-pointer <%= filterStatus === '' ? 'ring-2 ring-indigo-500 ring-offset-2' : '' %>">
    <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center shrink-0">
      <i data-lucide="layers" class="w-6 h-6 text-indigo-600"></i>
    </div>
    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Semua Pengajuan</p>
      <p class="text-2xl font-black text-slate-800"><%= stats.totalPending + stats.totalApproved + stats.totalRejected %></p>
    </div>
  </a>

  <a href="/cuti?status=PENDING_HR" class="hris-card flex items-center gap-5 hover:border-amber-200 hover:-translate-y-1 transition-all cursor-pointer <%= filterStatus === 'PENDING_HR' ? 'ring-2 ring-amber-400 ring-offset-2' : '' %>">
    <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center shrink-0">
      <i data-lucide="clock" class="w-6 h-6 text-amber-500"></i>
    </div>
    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Perlu Tindakan HR</p>
      <p class="text-2xl font-black text-amber-600"><%= stats.totalPending %></p>
    </div>
  </a>

  <a href="/cuti?status=APPROVED" class="hris-card flex items-center gap-5 hover:border-emerald-200 hover:-translate-y-1 transition-all cursor-pointer <%= filterStatus === 'APPROVED' ? 'ring-2 ring-emerald-500 ring-offset-2' : '' %>">
    <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center shrink-0">
      <i data-lucide="check-circle-2" class="w-6 h-6 text-emerald-600"></i>
    </div>
    <div>
      <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Disetujui Tahun Ini</p>
      <p class="text-2xl font-black text-emerald-600"><%= stats.totalApproved %></p>
    </div>
  </a>
</div>

<!-- LOG TABEL - SEMUA PENGAJUAN -->
<div class="hris-card p-0 overflow-hidden">
  <!-- Header Tabel -->
  <div class="px-6 py-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/40">
    <div class="flex items-center gap-3">
      <span class="w-2 h-6 bg-indigo-600 rounded-full"></span>
      <div>
        <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest">
          <% if (filterStatus === '') { %>Log Semua Pengajuan
          <% } else if (filterStatus === 'PENDING_HR') { %>Menunggu Keputusan HR
          <% } else if (filterStatus === 'PENDING_ATASAN') { %>Menunggu Atasan
          <% } else if (filterStatus === 'APPROVED') { %>Pengajuan Disetujui
          <% } else if (filterStatus === 'REJECTED') { %>Pengajuan Ditolak
          <% } else { %><%= filterStatus %><% } %>
        </h3>
        <p class="text-xs text-slate-400 mt-0.5">50 entri terbaru · urut dari yang paling baru</p>
      </div>
    </div>

    <!-- Filter Cepat -->
    <div class="flex items-center gap-2 flex-wrap">
      <a href="/cuti" class="text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-lg transition-all <%= filterStatus === '' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-500 hover:bg-slate-200' %>">Semua</a>
      <a href="/cuti?status=PENDING_HR" class="text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-lg transition-all <%= filterStatus === 'PENDING_HR' ? 'bg-amber-500 text-white' : 'bg-slate-100 text-slate-500 hover:bg-slate-200' %>">Perlu Aksi</a>
      <a href="/cuti?status=APPROVED" class="text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-lg transition-all <%= filterStatus === 'APPROVED' ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-500 hover:bg-slate-200' %>">Disetujui</a>
      <a href="/cuti?status=REJECTED" class="text-[10px] font-black uppercase tracking-wider px-3 py-1.5 rounded-lg transition-all <%= filterStatus === 'REJECTED' ? 'bg-rose-500 text-white' : 'bg-slate-100 text-slate-500 hover:bg-slate-200' %>">Ditolak</a>
    </div>
  </div>

  <!-- Tabel -->
  <div class="overflow-x-auto">
    <table class="hris-table">
      <thead>
        <tr>
          <th class="w-12">No</th>
          <th>Karyawan</th>
          <th>Diinput</th>
          <th>Masa Cuti</th>
          <th class="text-center">Hari</th>
          <th class="text-center">Status</th>
          <th class="text-right">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (requests.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center py-20">
              <div class="flex flex-col items-center opacity-30">
                <i data-lucide="calendar-x" class="w-12 h-12"></i>
                <p class="mt-4 font-bold uppercase tracking-widest text-xs">Belum ada pengajuan</p>
              </div>
            </td>
          </tr>
        <% } else { %>
          <% requests.forEach((r, idx) => { %>
            <%
              const statusMap = {
                PENDING_ATASAN: { label: 'Menunggu Atasan', cls: 'bg-slate-100 text-slate-500' },
                PENDING_HR:     { label: 'Perlu Aksi HR',   cls: 'bg-amber-50 text-amber-600' },
                APPROVED:       { label: 'Disetujui',       cls: 'bg-emerald-50 text-emerald-600' },
                REJECTED:       { label: 'Ditolak',         cls: 'bg-rose-50 text-rose-600' },
                CANCELLED:      { label: 'Dibatalkan',      cls: 'bg-slate-100 text-slate-400' }
              };
              const st = statusMap[r.status] || { label: r.status, cls: 'bg-slate-100 text-slate-600' };
              const fmtDate = (d) => new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
              const fmtShort = (d) => new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
            %>
            <tr class="group">
              <td class="font-bold text-slate-300"><%= idx + 1 %></td>
              <td>
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-indigo-100 rounded-xl flex items-center justify-center text-indigo-700 font-black text-sm shrink-0">
                    <%= r.employee.namaKaryawan.charAt(0) %>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-bold text-slate-800 text-sm"><%= r.employee.namaKaryawan %></span>
                    <div class="flex items-center gap-1.5 mt-0.5">
                      <span class="text-[10px] font-black text-indigo-600 bg-indigo-50 px-1.5 py-0.5 rounded"><%= r.employee.nik %></span>
                      <% if (r.employee.agent) { %>
                        <span class="text-[10px] text-slate-400"><%= r.employee.agent.name %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <span class="text-xs text-slate-500 font-medium"><%= fmtDate(r.tanggalPengajuan) %></span>
              </td>
              <td>
                <div class="flex items-center gap-1 text-xs font-bold text-slate-700">
                  <span><%= fmtShort(r.tanggalMulai) %></span>
                  <span class="text-slate-300 mx-1">→</span>
                  <span><%= fmtShort(r.tanggalAkhir) %></span>
                </div>
              </td>
              <td class="text-center">
                <span class="font-black text-slate-800"><%= r.jumlahHari %></span>
                <span class="text-[10px] text-slate-400 ml-0.5">hr</span>
              </td>
              <td class="text-center">
                <span class="hris-badge <%= st.cls %>"><%= st.label %></span>
              </td>
              <td class="text-right">
                <a href="/cuti/detail/<%= r.id %>" class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 font-bold text-xs uppercase tracking-wider transition-all opacity-0 group-hover:opacity-100">
                  Detail <i data-lucide="chevron-right" class="w-3 h-3"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Footer info -->
  <% if (requests.length >= 50) { %>
    <div class="px-6 py-4 border-t border-slate-50 bg-slate-50/30 text-center">
      <p class="text-xs text-slate-400 font-medium">Menampilkan 50 entri terbaru. Gunakan filter untuk mempersempit pencarian.</p>
    </div>
  <% } %>
</div>

<!-- MODAL CUTI BERSAMA MASSAL -->
<div id="modalCutiBersama" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 opacity-100 transition-opacity">
  <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden shadow-2xl transform transition-transform">
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-rose-100 rounded-full flex items-center justify-center text-rose-600">
          <i data-lucide="alert-triangle" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 class="font-bold text-slate-800 text-lg">Potong Cuti Massal</h3>
          <p class="text-xs text-slate-500">Eksekusi Cuti Bersama Nasional</p>
        </div>
      </div>
      <button onclick="document.getElementById('modalCutiBersama').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 p-2">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6">
      <p class="text-sm text-slate-600 mb-5 leading-relaxed">
        Aksi ini akan memotong saldo cuti tahunan <strong class="text-slate-800">seluruh karyawan aktif</strong> secara otomatis sesuai dengan rentang tanggal di bawah ini.
      </p>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Rentang Tanggal Libur</label>
          <div class="flex items-center gap-2">
            <input type="date" id="massStartDate" class="hris-input w-full text-sm">
            <span class="text-slate-400 font-bold">→</span>
            <input type="date" id="massEndDate" class="hris-input w-full text-sm">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Keterangan / Alasan</label>
          <input type="text" id="massKeterangan" placeholder="Contoh: Cuti Bersama Idul Fitri" class="hris-input w-full text-sm">
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
      <button onclick="document.getElementById('modalCutiBersama').classList.add('hidden')" class="px-4 py-2 font-bold text-sm text-slate-600 hover:bg-slate-200 bg-slate-100 rounded-xl transition-all">Batal</button>
      <button id="btnEksekusiMassal" onclick="eksekusiCutiMassal()" class="bg-rose-600 hover:bg-rose-700 text-white px-5 py-2 font-bold text-sm rounded-xl shadow-lg shadow-rose-200 transition-all flex items-center">
        <i data-lucide="zap" class="w-4 h-4 mr-2"></i> Eksekusi Sekarang
      </button>
    </div>
  </div>
</div>

<script>
  async function eksekusiCutiMassal() {
    const start = document.getElementById('massStartDate').value;
    const end = document.getElementById('massEndDate').value;
    const keterangan = document.getElementById('massKeterangan').value;
    const btn = document.getElementById('btnEksekusiMassal');

    if (!start || !end || !keterangan) {
      alert('Mohon lengkapi tanggal dan keterangan cuti bersama!');
      return;
    }

    if (confirm('PERINGATAN!\\nAksi ini akan memotong kuota cuti tahunan karyawan secara massal.\\n\\nAnda yakin ingin melanjutkan?')) {
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i data-lucide=\"loader-2\" class=\"w-4 h-4 mr-2 animate-spin\"></i> Memproses...';
      btn.disabled = true;

      try {
        const response = await fetch('/api/cuti/massal', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            tanggalMulai: start,
            tanggalAkhir: end,
            keterangan: keterangan
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert(result.message);
          window.location.reload();
        } else {
          alert('Gagal: ' + result.message);
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      } catch (err) {
        alert('Terjadi kesalahan sistem.');
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }
  }
</script>
