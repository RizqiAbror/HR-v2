<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i> Form Input Cuti (Admin HR)</h5>
      </div>
      <div class="card-body bg-light">
        <form id="formCuti" enctype="multipart/form-data">
          
          <!-- ADMIN INFO HIDDEN -->
          <input type="hidden" id="adminNik" value="<%= user ? user.nik : 'ADMIN' %>">

          <div class="mb-4 p-3 border rounded bg-white shadow-sm">
            <label for="nik" class="form-label fw-bold text-primary">1. Pilih Karyawan</label>
            <select class="form-select" id="nik" required>
              <option value="" selected disabled>-- Cari atau Pilih Karyawan --</option>
              <% employees.forEach(emp => { %>
                <option value="<%= emp.nik %>"><%= emp.namaKaryawan %> (<%= emp.nik %>) - <%= emp.agent.name %></option>
              <% }) %>
            </select>
            <div id="quotaInfo" class="mt-2 text-danger fw-bold d-none">
              <i class="bi bi-info-circle"></i> Sisa cuti tahunan: <span id="sisaCutiText">0</span> hari
            </div>
          </div>
          
          <div class="row mb-3">
            <div class="col-md-12">
              <label for="jenisCuti" class="form-label fw-bold">2. Jenis Pengajuan</label>
              <select class="form-select" id="jenisCuti" required>
                <option value="TAHUNAN">Cuti Tahunan (Potong Jatah)</option>
                <option value="SAKIT">Sakit (Wajib Lampiran Surat Dokter)</option>
                <option value="IZIN_KHUSUS">Izin Khusus (Menikah, Berduka, dll)</option>
              </select>
              <div id="jenisInfo" class="form-text text-info">Cuti tahunan akan memotong saldo cuti karyawan.</div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label d-flex justify-content-between fw-bold">
              3. Pilih Tanggal Cuti
              <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddDate">
                <i class="bi bi-plus-lg"></i> Tambah Tanggal
              </button>
            </label>
            <div id="dateList">
              <div class="input-group mb-2 date-row">
                <input type="date" class="form-control cuti-date" required>
                <button type="button" class="btn btn-outline-danger btn-remove" disabled><i class="bi bi-trash"></i></button>
              </div>
            </div>
            <small class="text-muted">Gunakan tombol 'Tambah Tanggal' jika tanggal yang diajukan terputus-putus (tidak berurutan).</small>
          </div>
          
          <div id="infoHari" class="mb-3 text-primary fw-bold"></div>
          
          <div class="mb-3">
            <label for="alasan" class="form-label fw-bold">4. Alasan / Keterangan</label>
            <textarea class="form-control" id="alasan" rows="2" placeholder="Tuliskan keterangan cuti sesuai dengan surat fisik" required></textarea>
          </div>

          <div class="mb-4">
            <label for="attachment" class="form-label fw-bold">5. Upload Foto/Scan Surat (Wajib)</label>
            <input class="form-control" type="file" id="attachment" accept="image/*,application/pdf" required>
            <div class="form-text">Berdasarkan kebijakan, HR wajib mengunggah foto surat cuti/sakit yang sudah di-TTD.</div>
          </div>
          
          <div class="d-flex justify-content-between border-top pt-3">
            <a href="/cuti" class="btn btn-light border">Batal</a>
            <button type="submit" class="btn btn-dark px-4" id="btnSubmit" disabled>Proses & Simpan</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  let sisaCuti = 0;
  
  const nikSelect = document.getElementById('nik');
  const quotaInfo = document.getElementById('quotaInfo');
  const sisaCutiText = document.getElementById('sisaCutiText');
  
  const dateList = document.getElementById('dateList');
  const btnAddDate = document.getElementById('btnAddDate');
  const infoHari = document.getElementById('infoHari');
  const formCuti = document.getElementById('formCuti');
  const btnSubmit = document.getElementById('btnSubmit');
  const jenisCutiSelect = document.getElementById('jenisCuti');
  const jenisInfo = document.getElementById('jenisInfo');

  // FETCH QUOTA SAAT KARYAWAN DIPILIH
  nikSelect.addEventListener('change', async () => {
    const nik = nikSelect.value;
    if (!nik) return;
    
    try {
      const res = await fetch(`/api/cuti/sisa?nik=${nik}`);
      const data = await res.json();
      if (data.success) {
        sisaCuti = data.sisa_cuti;
        sisaCutiText.innerText = sisaCuti;
        quotaInfo.classList.remove('d-none');
        quotaInfo.className = `mt-2 fw-bold ${sisaCuti > 0 ? 'text-success' : 'text-danger'}`;
        hitungHari(); // Re-validasi tombol submit
      }
    } catch (e) {
      console.error('Gagal mengambil kuota');
    }
  });

  jenisCutiSelect.addEventListener('change', () => {
    const val = jenisCutiSelect.value;
    if (val === 'TAHUNAN') {
      jenisInfo.innerText = 'Cuti tahunan akan memotong saldo cuti.';
      jenisInfo.className = 'form-text text-info';
    } else if (val === 'SAKIT') {
      jenisInfo.innerText = 'Pastikan surat dokter diupload.';
      jenisInfo.className = 'form-text text-danger fw-bold';
    } else {
      jenisInfo.innerText = 'Izin khusus tidak memotong jatah cuti tahunan.';
      jenisInfo.className = 'form-text text-success';
    }
    hitungHari();
  });

  btnAddDate.addEventListener('click', () => {
    const row = document.createElement('div');
    row.className = 'input-group mb-2 date-row';
    row.innerHTML = `
      <input type="date" class="form-control cuti-date" required>
      <button type="button" class="btn btn-outline-danger btn-remove"><i class="bi bi-trash"></i></button>
    `;
    dateList.appendChild(row);
    attachEvents(row);
    hitungHari();
  });

  function attachEvents(row) {
    row.querySelector('.btn-remove')?.addEventListener('click', () => { row.remove(); hitungHari(); });
    row.querySelector('.cuti-date').addEventListener('change', hitungHari);
  }

  document.querySelectorAll('.date-row').forEach(attachEvents);

  async function hitungHari() {
    if (!nikSelect.value) return; // Belum pilih karyawan
    
    const inputs = document.querySelectorAll('.cuti-date');
    const dates = Array.from(inputs).map(i => i.value).filter(v => v);
    if (dates.length > 0) {
      const uniqueDates = [...new Set(dates)];
      const jml = uniqueDates.length;
      let infoHtml = `Total: ${jml} tanggal dipilih.`;
      
      if (jenisCutiSelect.value === 'TAHUNAN' && jml > sisaCuti) {
        infoHtml += ' <span class="text-danger">(Melebihi sisa cuti!)</span>';
        btnSubmit.disabled = true;
      } else {
        btnSubmit.disabled = false;
      }
      infoHari.innerHTML = infoHtml;
    } else {
      infoHari.innerHTML = '';
      btnSubmit.disabled = true;
    }
  }

  formCuti.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const attachment = document.getElementById('attachment');
    if (attachment.files.length === 0) {
      alert('Anda wajib melampirkan foto/scan surat cuti!');
      return;
    }

    const inputs = document.querySelectorAll('.cuti-date');
    const dates = Array.from(inputs).map(i => i.value).filter(v => v);
    
    // Gunakan FormData untuk upload file
    const formData = new FormData();
    formData.append('nik', nikSelect.value);
    formData.append('dates', JSON.stringify(dates));
    formData.append('alasan', document.getElementById('alasan').value);
    formData.append('jenisCuti', jenisCutiSelect.value);
    formData.append('adminNik', document.getElementById('adminNik').value); // Catat siapa adminnya
    formData.append('attachment', attachment.files[0]);
    
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Menyimpan...';
    
    try {
      // KITA GUNAKAN ENDPOINT admin-submit KARENA INI DI-INPUT OLEH HR
      const response = await fetch('/api/cuti/admin-submit', {
        method: 'POST',
        body: formData
      });
      
      const data = await response.json();
      if (data.success) {
        alert('Data cuti berhasil disimpan ke dalam sistem!');
        window.location.href = '/cuti';
      } else {
        alert('Gagal: ' + data.message);
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = 'Proses & Simpan';
      }
    } catch (e) {
      alert('Terjadi kesalahan sistem');
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = 'Proses & Simpan';
    }
  });
</script>
