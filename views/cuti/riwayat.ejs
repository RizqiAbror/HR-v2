<%
  function fmtDate(d) {
    if (!d) return '-';
    const dd = new Date(d);
    return dd.toLocaleDateString('id-ID', { day:'2-digit', month:'2-digit', year:'numeric' });
  }
%>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/cuti">Manajemen Cuti</a></li>
    <li class="breadcrumb-item active">Riwayat Cuti - <%= employee.namaKaryawan %></li>
  </ol>
</nav>

<!-- A. HEADER INFO KARYAWAN -->
<div class="card shadow-sm mb-3">
  <div class="card-body">
    <div class="row align-items-center">
      <div class="col-md-6">
        <h5 class="mb-1 fw-bold"><%= employee.namaKaryawan %></h5>
        <div class="text-muted small">
          <span class="me-3"><i class="bi bi-person-badge"></i> <%= employee.nik %></span>
          <span class="me-3"><i class="bi bi-briefcase"></i> <%= employee.jabatan %></span>
          <span><i class="bi bi-building"></i> <%= employee.agent ? employee.agent.code : '-' %></span>
        </div>
      </div>
      
      <% if (quota) { %>
        <div class="col-md-6 mt-3 mt-md-0 border-start ps-md-4">
          <% 
            const percent = (quota.cutiTerpakai / quota.jumlahCuti) * 100;
            const remainingPercent = 100 - percent;
            let pColor = 'success';
            if (remainingPercent < 25) pColor = 'danger';
            else if (remainingPercent <= 50) pColor = 'warning';
          %>
          <div class="d-flex justify-content-between mb-1 small">
            <span>Terpakai: <strong><%= quota.cutiTerpakai %> hari</strong></span>
            <span>Sisa: <strong class="text-<%= pColor %>"><%= sisa_cuti %> hari</strong></span>
            <span class="text-muted">Total: <%= quota.jumlahCuti %> hari</span>
          </div>
          <div class="progress" style="height: 10px;">
            <div class="progress-bar bg-<%= pColor %>" role="progressbar" style="width: <%= percent %>%" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
      <% } else { %>
        <div class="col-md-6 mt-3 mt-md-0 border-start ps-md-4 d-flex align-items-center">
          <span class="text-muted small"><i class="bi bi-info-circle me-1"></i> Data kuota tidak ditemukan untuk tahun <%= tahun %></span>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- B. FILTER TAHUN -->
<div class="mb-3 d-flex justify-content-between align-items-center">
  <form method="GET" action="/cuti/riwayat/<%= employee.nik %>" class="d-flex align-items-center gap-2">
    <label for="tahun" class="form-label mb-0 small text-muted">Filter Tahun:</label>
    <select name="tahun" id="tahun" class="form-select form-select-sm" style="width: auto;">
      <option value="2024" <%= tahun === 2024 ? 'selected' : '' %>>2024</option>
      <option value="2025" <%= tahun === 2025 ? 'selected' : '' %>>2025</option>
      <option value="2026" <%= tahun === 2026 ? 'selected' : '' %>>2026</option>
    </select>
    <button type="submit" class="btn btn-sm btn-primary">Filter</button>
  </form>
</div>

<!-- C. TABEL RIWAYAT -->
<div class="card shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover table-striped mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3">No</th>
            <th>Request No</th>
            <th>Tgl Pengajuan</th>
            <th>Tgl Mulai</th>
            <th>Tgl Akhir</th>
            <th>Hari</th>
            <th>Alasan</th>
            <th>Status</th>
            <th>Surat</th>
            <th class="pe-3">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr>
              <td colspan="10" class="text-center py-4 text-muted">Belum ada riwayat cuti</td>
            </tr>
          <% } else { %>
            <% requests.forEach((r, idx) => { %>
              <% 
                const statusMap = {
                  PENDING_ATASAN: { label:'Menunggu Atasan', cls:'warning text-dark' },
                  PENDING_HR:     { label:'Menunggu HR',     cls:'info text-dark' },
                  APPROVED:       { label:'Disetujui',       cls:'success' },
                  REJECTED:       { label:'Ditolak',         cls:'danger' },
                  CANCELLED:      { label:'Dibatalkan',      cls:'secondary' }
                };
                const st = statusMap[r.status] || { label: r.status, cls:'secondary' };
              %>
              <tr>
                <td class="ps-3"><%= idx + 1 %></td>
                <td><small><strong><%= r.requestNo %></strong></small></td>
                <td><small><%= fmtDate(r.tanggalPengajuan) %></small></td>
                <td><small><%= fmtDate(r.tanggalMulai) %></small></td>
                <td><small><%= fmtDate(r.tanggalAkhir) %></small></td>
                <td><%= r.jumlahHari %></td>
                <td><small class="text-truncate d-inline-block" style="max-width: 150px;" title="<%= r.alasan %>"><%= r.alasan %></small></td>
                <td><span class="badge bg-<%= st.cls %>"><%= st.label %></span></td>
                <td>
                  <% if (r.attachmentUrl) { %>
                    <a href="<%= r.attachmentUrl %>" target="_blank" class="text-decoration-none small"><i class="bi bi-file-earmark-text"></i> Lihat</a>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td class="pe-3">
                  <% if ((r.status === 'PENDING_ATASAN' || r.status === 'PENDING_HR') && currentUser.nik === employee.nik) { %>
                    <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.8rem;" onclick="batalkan(<%= r.id %>)">Batalkan</button>
                  <% } else if (currentUser.role === 'HR_ADMIN' || currentUser.role === 'ATASAN') { %>
                    <a href="/cuti/<%= r.id %>" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">Detail</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- D. SCRIPT -->
<script>
  async function batalkan(id) {
    if (!confirm('Batalkan pengajuan ini?')) return;
    
    try {
      const response = await fetch(`/api/cuti/cancel/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const data = await response.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert('Gagal: ' + data.message);
      }
    } catch (error) {
      alert('Terjadi kesalahan sistem');
    }
  }
</script>
