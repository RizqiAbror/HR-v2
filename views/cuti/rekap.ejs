<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
  <div>
    <h2 class="text-3xl font-extrabold text-slate-800 tracking-tight">Rekapitulasi Kuota Cuti</h2>
    <p class="text-slate-500 mt-1 font-medium">Laporan sisa jatah cuti seluruh karyawan secara real-time.</p>
  </div>
  <div>
    <span class="hris-badge bg-indigo-50 text-indigo-600 px-4 py-2">Tahun Periode: <%= year %></span>
  </div>
</div>

<!-- FILTER BAR -->
<div class="hris-card mb-8">
  <form method="GET" action="/cuti/rekap" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
    <div class="md:col-span-5">
      <label class="hris-label">Pencarian Karyawan</label>
      <div class="relative">
        <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5"></i>
        <input type="text" name="search" class="hris-input pl-11" placeholder="Nama atau NIK..." value="<%= search %>">
      </div>
    </div>
    <div class="md:col-span-4">
      <label class="hris-label">Pilih Tahun</label>
      <select name="year" class="hris-input appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22m6%208%204%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem_1.25rem] bg-[right_0.5rem_center] bg-no-repeat">
        <% for(let y = new Date().getFullYear(); y >= 2024; y--) { %>
          <option value="<%= y %>" <%= parseInt(year) === y ? 'selected' : '' %>><%= y %></option>
        <% } %>
      </select>
    </div>
    <div class="md:col-span-3 flex gap-2">
      <button type="submit" class="hris-btn-primary w-full py-2.5">Tampilkan</button>
      <a href="/cuti/rekap" class="hris-btn-outline w-full py-2.5 text-center text-xs">Reset</a>
    </div>
  </form>
</div>

<!-- DATA TABLE -->
<div class="hris-table-container">
  <table class="hris-table">
    <thead>
      <tr>
        <th class="w-16">No</th>
        <th>Nama Karyawan / NIK</th>
        <th>Agent</th>
        <th class="text-center">Jatah Awal</th>
        <th class="text-center">Terpakai</th>
        <th class="text-center font-black text-indigo-600">Sisa Kuota</th>
        <th class="text-right">Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% if (quotas.length === 0) { %>
        <tr>
          <td colspan="7" class="text-center py-20 text-slate-400 italic font-medium">Data kuota tidak ditemukan untuk periode ini</td>
        </tr>
      <% } else { %>
        <% quotas.forEach((q, idx) => { %>
          <tr class="group">
            <td class="text-slate-300 font-bold"><%= idx + 1 %></td>
            <td>
              <div class="flex flex-col">
                <span class="font-bold text-slate-800"><%= q.employee.namaKaryawan %></span>
                <span class="text-[10px] font-bold text-indigo-600 px-2 py-0.5 bg-indigo-50 rounded w-fit mt-1"><%= q.employee.nik %></span>
              </div>
            </td>
            <td>
              <span class="text-sm text-slate-500 font-medium"><%= q.employee.agent ? q.employee.agent.name : '-' %></span>
            </td>
            <td class="text-center font-bold text-slate-600"><%= q.jumlahCuti %></td>
            <td class="text-center text-rose-500 font-bold"><%= q.cutiTerpakai %></td>
            <td class="text-center">
              <% const sisa = q.jumlahCuti - q.cutiTerpakai; %>
              <span class="text-lg font-black <%= sisa > 0 ? 'text-indigo-600' : 'text-rose-600' %>"><%= sisa %></span>
            </td>
            <td class="text-right">
              <a href="/employee/<%= q.employee.nik %>" class="text-slate-400 hover:text-indigo-600 transition-colors">
                <i data-lucide="user-round" class="w-6 h-6"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>
