<!-- BREADCRUMB -->
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/cuti">Manajemen Cuti</a></li>
    <li class="breadcrumb-item active">Rekap Kuota Cuti</li>
  </ol>
</nav>

<!-- FILTER BAR -->
<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-body py-2 px-3">
        <form method="GET" action="/cuti/rekap" class="row g-2 align-items-center">
          <div class="col-auto">
            <select name="tahun" class="form-select form-select-sm">
              <option value="2024" <%= tahun === 2024 ? 'selected' : '' %>>Tahun 2024</option>
              <option value="2025" <%= tahun === 2025 ? 'selected' : '' %>>Tahun 2025</option>
              <option value="2026" <%= tahun === 2026 ? 'selected' : '' %>>Tahun 2026</option>
            </select>
          </div>
          <div class="col-auto">
            <select name="agent" class="form-select form-select-sm">
              <option value="">Semua Agent</option>
              <% agents.forEach(a => { %>
                <option value="<%= a.code %>" <%= agentCode === a.code ? 'selected' : '' %>>
                  <%= a.name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Filter</button>
            <a href="/cuti/rekap" class="btn btn-outline-secondary btn-sm">Reset</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- SUMMARY CARDS -->
<% 
  const totalKaryawan = quotas.length;
  const sumSisa = quotas.reduce((sum, q) => sum + q.sisa_cuti, 0);
  const avgSisa = totalKaryawan > 0 ? (sumSisa / totalKaryawan).toFixed(1) : 0;
  const zeroSisaCount = quotas.filter(q => q.sisa_cuti === 0).length;
%>
<div class="row mb-4">
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h6 class="card-title text-muted mb-1">Total Karyawan</h6>
        <h3 class="mb-0 fw-bold"><%= totalKaryawan %></h3>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h6 class="card-title text-muted mb-1">Rata-rata Sisa Cuti</h6>
        <h3 class="mb-0 fw-bold"><%= avgSisa %> <span class="fs-6 text-muted fw-normal">hari</span></h3>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100 <%= zeroSisaCount > 0 ? 'border-danger' : '' %>">
      <div class="card-body">
        <h6 class="card-title text-muted mb-1">Karyawan Sisa 0 Hari</h6>
        <h3 class="mb-0 fw-bold <%= zeroSisaCount > 0 ? 'text-danger' : '' %>"><%= zeroSisaCount %></h3>
      </div>
    </div>
  </div>
</div>

<!-- TABEL REKAP -->
<div class="card shadow-sm">
  <div class="card-header bg-white py-3">
    <h5 class="mb-0">Data Kuota Cuti Karyawan</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="ps-3 py-2">No</th>
            <th>NIK</th>
            <th>Nama</th>
            <th>Agent</th>
            <th>Jabatan</th>
            <th class="text-center">Jatah</th>
            <th class="text-center">Terpakai</th>
            <th class="text-center">Sisa</th>
            <th class="text-center pe-3">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (quotas.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center py-4 text-muted">Tidak ada data kuota cuti untuk filter ini</td>
            </tr>
          <% } else { %>
            <% quotas.forEach((q, idx) => { %>
              <tr>
                <td class="ps-3"><%= idx + 1 %></td>
                <td><%= q.employee.nik %></td>
                <td class="fw-medium"><%= q.employee.namaKaryawan %></td>
                <td><span class="badge bg-light text-dark border"><%= q.employee.agent ? q.employee.agent.code : '-' %></span></td>
                <td><%= q.employee.jabatan %></td>
                <td class="text-center"><%= q.jumlahCuti %></td>
                <td class="text-center"><%= q.cutiTerpakai %></td>
                <td class="text-center">
                  <% 
                    let badgeClass = 'success';
                    if (q.sisa_cuti === 0) badgeClass = 'danger';
                    else if (q.sisa_cuti <= 5) badgeClass = 'warning text-dark';
                  %>
                  <span class="badge bg-<%= badgeClass %>"><%= q.sisa_cuti %></span>
                </td>
                <td class="text-center pe-3">
                  <a href="/cuti/riwayat/<%= q.employee.nik %>" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">
                    Riwayat
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
