<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | Skydash HRIS</title>
  
  <!-- Fonts & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    .app-wrapper {
      display: flex;
      height: 100vh;
      width: 100vw;
    }

    .sidebar-container {
      width: 260px;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 1000;
    }

    .main-panel {
      flex: 1;
      margin-left: 260px;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    .navbar {
      height: 70px;
      background: #ffffff;
      padding: 0 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #f3f3f3;
    }

    .content-wrapper {
      flex: 1;
      overflow-y: auto;
      padding: 30px 40px;
    }

    @media (max-width: 991px) {
      .sidebar-container { display: none; }
      .main-panel { margin-left: 0; }
    }
  </style>
</head>
<body>

  <div class="app-wrapper">
    <!-- SIDEBAR -->
    <aside class="sidebar-container">
      <div class="sidebar h-100">
        <%- include('../partials/sidebar') %>
      </div>
    </aside>

    <!-- MAIN PANEL -->
    <div class="main-panel">
      <!-- NAVBAR -->
      <nav class="navbar">
        <div class="d-flex align-items-center">
          <i class="bi bi-list fs-4 me-3 d-lg-none"></i>
          <h4 class="mb-0 fw-bold"><%= pageTitle %></h4>
        </div>

        <% if (currentUser) { %>
          <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-md-block">
              <p class="mb-0 fw-bold small text-dark"><%= currentUser.nama %></p>
              <small class="text-muted" style="font-size: 0.7rem;"><%= currentUser.role %></small>
            </div>
            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
              <%= currentUser.nama.charAt(0) %>
            </div>
          </div>
        <% } %>
      </nav>

      <!-- CONTENT -->
      <div class="content-wrapper">
        <div class="container-fluid p-0">
          <%- body %>
        </div>
        
        <footer class="mt-5 pb-4 text-center text-muted small">
          <p>Hand-crafted & made with <i class="bi bi-heart-fill text-danger"></i> for Kalapa HR</p>
        </footer>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
