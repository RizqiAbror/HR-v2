<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | Tailwind HRIS</title>
  
  <!-- Fonts & Icons (Lucide) -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- Tailwind Output -->
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="font-sans text-slate-900">

  <div class="flex h-screen overflow-hidden">
    <!-- SIDEBAR (Tailwind) -->
    <aside class="w-64 bg-white border-r border-slate-200 flex-shrink-0 hidden lg:flex flex-col z-10 shadow-sm">
      <div class="h-full overflow-y-auto">
        <%- include('../partials/sidebar') %>
      </div>
    </aside>

    <!-- MAIN PANEL -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      
      <!-- NAVBAR (Tailwind) -->
      <nav class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shrink-0 z-20">
        <div class="flex items-center">
          <button class="lg:hidden p-2 -ml-2 mr-2 text-slate-600">
            <i data-lucide="menu" class="w-7 h-7"></i>
          </button>
          <h1 class="text-xl font-bold tracking-tight text-slate-800"><%= pageTitle %></h1>
        </div>

        <% if (currentUser) { %>
          <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
              <p class="text-sm font-semibold text-slate-900"><%= currentUser.nama %></p>
              <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider"><%= currentUser.role %></p>
            </div>
            <div class="h-10 w-10 bg-indigo-600 rounded-full flex items-center justify-center text-white font-bold shadow-md shadow-indigo-100">
              <%= currentUser.nama.charAt(0) %>
            </div>
          </div>
        <% } %>
      </nav>

      <!-- CONTENT (Tailwind Scroll Area) -->
      <main class="flex-1 overflow-y-auto p-8 custom-scrollbar">
        <div class="max-w-7xl mx-auto">
          <%- body %>
        </div>
        
        <footer class="mt-12 py-8 text-center text-slate-400 text-xs border-t border-slate-200">
          <p>Built with Tailwind CSS & ❤️ for Kalapa HR</p>
        </footer>
      </main>
    </div>
  </div>

  <!-- Scripts (Pure JS only) -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();
  </script>
</body>
</html>
