<div class="brand-wrapper px-4 py-4 d-flex align-items-center">
  <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
    <i class="bi bi-layers-fill text-white fs-5"></i>
  </div>
  <h5 class="mb-0 fw-bold text-dark" style="letter-spacing: 0.5px;">SKYDASH<span class="text-primary">.</span></h5>
</div>

<ul class="nav flex-column mt-2">
  <li class="nav-item">
    <a class="nav-link <%= typeof pageTitle !== 'undefined' && pageTitle === 'Dashboard' ? 'active' : '' %>" href="/">
      <i class="bi bi-grid-fill"></i>
      <span>Dashboard</span>
    </a>
  </li>

  <p class="text-muted small fw-bold px-4 mt-4 mb-2" style="font-size: 0.65rem; text-transform: uppercase;">Manajemen</p>

  <li class="nav-item">
    <a class="nav-link <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Cuti') && pageTitle !== 'Rekap Kuota Cuti' && pageTitle !== 'Data Karyawan' ? 'active' : '' %>" href="/cuti">
      <i class="bi bi-calendar-check"></i>
      <span>Cuti Karyawan</span>
    </a>
  </li>

  <% if (currentUser && currentUser.role === 'HR_ADMIN') { %>
    <li class="nav-item">
      <a class="nav-link <%= typeof pageTitle !== 'undefined' && (pageTitle === 'Rekap Kuota Cuti' || pageTitle === 'Rekapitulasi Kuota Cuti') ? 'active' : '' %>" href="/cuti/rekap">
        <i class="bi bi-pie-chart"></i>
        <span>Rekap Kuota</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= typeof pageTitle !== 'undefined' && pageTitle === 'Data Karyawan' ? 'active' : '' %>" href="/employee">
        <i class="bi bi-people"></i>
        <span>Data Karyawan</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= typeof pageTitle !== 'undefined' && pageTitle === 'Data Agent (Project)' ? 'active' : '' %>" href="/agent">
        <i class="bi bi-briefcase"></i>
        <span>Data Agent</span>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= typeof pageTitle !== 'undefined' && pageTitle === 'Libur Nasional' ? 'active' : '' %>" href="/libur-nasional">
        <i class="bi bi-calendar3"></i>
        <span>Libur Nasional</span>
      </a>
    </li>
    
    <p class="text-muted small fw-bold px-4 mt-4 mb-2" style="font-size: 0.65rem; text-transform: uppercase;">Sistem</p>
    <li class="nav-item">
      <a class="nav-link <%= typeof pageTitle !== 'undefined' && pageTitle.includes('Audit') ? 'active' : '' %>" href="/audit-trail">
        <i class="bi bi-shield-check"></i>
        <span>Audit Trail</span>
      </a>
    </li>
  <% } %>
  
  <li class="nav-item mt-5 pt-4 border-top">
    <a class="nav-link text-danger" href="/logout">
      <i class="bi bi-box-arrow-right"></i>
      <span>Logout</span>
    </a>
  </li>
</ul>
