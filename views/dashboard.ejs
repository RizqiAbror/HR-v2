<div class="mb-10">
  <h2 class="text-3xl font-extrabold text-slate-800 tracking-tight">Selamat Datang, <%= currentUser.nama %>!</h2>
  <p class="text-slate-500 mt-2 font-medium">Semua sistem berjalan normal. Anda memiliki <span class="text-indigo-600 font-bold"><%= stats.pendingLeave %> antrean cuti</span> yang perlu diproses.</p>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  <!-- Card 1: Total Employee -->
  <div class="bg-indigo-600 rounded-[2.5rem] p-8 text-white shadow-2xl shadow-indigo-200 flex flex-col justify-between h-64 transition-all hover:scale-[1.02] duration-300 relative overflow-hidden group">
    <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-white/10 rounded-full blur-2xl group-hover:bg-white/20 transition-all"></div>
    <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center relative z-10">
      <i data-lucide="users" class="w-7 h-7 text-white"></i>
    </div>
    <div class="relative z-10">
      <p class="text-indigo-100 font-bold uppercase tracking-widest text-[10px]">Total Karyawan</p>
      <h3 class="text-5xl font-black mt-1"><%= stats.totalEmployee %></h3>
    </div>
    <div class="flex items-center text-indigo-100 text-xs font-bold uppercase tracking-tighter relative z-10">
      <span>SDM Terdaftar</span>
      <i data-lucide="chevron-right" class="ml-1 w-4 h-4"></i>
    </div>
  </div>

  <!-- Card 2: Pending Leave -->
  <div class="bg-amber-500 rounded-[2.5rem] p-8 text-white shadow-2xl shadow-amber-100 flex flex-col justify-between h-64 transition-all hover:scale-[1.02] duration-300 relative overflow-hidden group">
    <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-white/10 rounded-full blur-2xl group-hover:bg-white/20 transition-all"></div>
    <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center relative z-10">
      <i data-lucide="clock" class="w-7 h-7 text-white"></i>
    </div>
    <div class="relative z-10">
      <p class="text-amber-50 font-bold uppercase tracking-widest text-[10px]">Antrean Cuti</p>
      <h3 class="text-5xl font-black mt-1"><%= stats.pendingLeave %></h3>
    </div>
    <div class="flex items-center text-amber-50 text-xs font-bold uppercase tracking-tighter relative z-10">
      <span>Menunggu Approval</span>
      <i data-lucide="chevron-right" class="ml-1 w-4 h-4"></i>
    </div>
  </div>

  <!-- Card 3: Total Agent -->
  <div class="bg-slate-800 rounded-[2.5rem] p-8 text-white shadow-2xl shadow-slate-200 flex flex-col justify-between h-64 transition-all hover:scale-[1.02] duration-300 relative overflow-hidden group">
    <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-white/10 rounded-full blur-2xl group-hover:bg-white/20 transition-all"></div>
    <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center relative z-10">
      <i data-lucide="building-2" class="w-7 h-7 text-white"></i>
    </div>
    <div class="relative z-10">
      <p class="text-slate-400 font-bold uppercase tracking-widest text-[10px]">Total Agent</p>
      <h3 class="text-5xl font-black mt-1"><%= stats.totalAgent %></h3>
    </div>
    <div class="flex items-center text-slate-400 text-xs font-bold uppercase tracking-tighter relative z-10">
      <span>Proyek Berjalan</span>
      <i data-lucide="chevron-right" class="ml-1 w-4 h-4"></i>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-12">
  <!-- Charts Column -->
  <div class="lg:col-span-8 hris-card">
    <div class="flex justify-between items-center mb-8">
      <h4 class="text-lg font-bold text-slate-800">Visualisasi Data Cuti</h4>
      <div class="px-4 py-1.5 bg-slate-50 rounded-xl text-[10px] font-black text-slate-500 uppercase tracking-widest">Tahun 2026</div>
    </div>
    <div class="h-72 bg-slate-50 rounded-[2rem] border-2 border-dashed border-slate-100 flex flex-col items-center justify-center text-slate-400 group">
      <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-4 transition-transform group-hover:rotate-12">
        <i data-lucide="bar-chart-3" class="w-8 h-8 text-indigo-200"></i>
      </div>
      <p class="font-bold text-xs uppercase tracking-widest opacity-40">Modul Grafik Sedang Disiapkan</p>
    </div>
  </div>

  <!-- Activity Column -->
  <div class="lg:col-span-4 hris-card">
    <h4 class="text-lg font-bold text-slate-800 mb-8">Update Sistem</h4>
    <div class="space-y-8">
      <div class="flex items-start">
        <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shrink-0">
          <i data-lucide="palette" class="w-5 h-5"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-bold text-slate-800">UI/UX Migration Complete</p>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">Seluruh antarmuka telah dimigrasi ke Tailwind CSS Premium.</p>
        </div>
      </div>
      <div class="flex items-start">
        <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center shrink-0">
          <i data-lucide="shield-check" class="w-5 h-5"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-bold text-slate-800">Keamanan Data Terjamin</p>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">Sistem Audit Trail sekarang mencatat setiap perubahan data sensitif.</p>
        </div>
      </div>
      <div class="pt-6 mt-4 border-t border-slate-50">
        <a href="/audit-trail" class="flex items-center justify-center gap-2 text-indigo-600 text-[10px] font-black uppercase tracking-widest hover:gap-4 transition-all">
          Buka Audit Trail <i data-lucide="arrow-right" class="w-3 h-3"></i>
        </a>
      </div>
    </div>
  </div>
</div>
