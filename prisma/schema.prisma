// ============================================================
// SCHEMA PRISMA — MODUL HR v2.3 (Final Auth Integration)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Agent {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(200)
  code       String     @unique @db.VarChar(50)
  status     String     @default("ACTIVE") @db.VarChar(20)
  createdAt  DateTime   @default(now())
  employees  Employee[]

  @@map("agents")
}

model Employee {
  id                 Int      @id @default(autoincrement())
  nik                String   @unique @db.VarChar(50)
  agentId            Int
  agent              Agent    @relation(fields: [agentId], references: [id])

  // Data personal
  namaKaryawan       String   @db.VarChar(200)
  nomorKtp           String?  @db.VarChar(20)
  statusPerkawinan   String?  @db.VarChar(20)

  // Data pekerjaan
  jabatan            String   @db.VarChar(100)
  statusTk           String   @db.VarChar(10)  // PKWT / PKM
  divisi             String?  @db.VarChar(100)
  jointDate          DateTime @db.Date
  endDate            DateTime? @db.Date
  statusKaryawan     String   @default("ACTIVE") @db.VarChar(20)

  // Data Keuangan & Bank
  gajiPokok          Float    @default(0)
  allowance          Float    @default(0)
  jkk                Float?   @default(0)
  jkm                Float?   @default(0)
  jht                Float?   @default(0)
  kesehatan          Float?   @default(0)
  pph21              Float?   @default(0)
  bonus              Float?   @default(0)
  namaBank           String?  @db.VarChar(50)
  noRekening         String?  @db.VarChar(50)
  namaRekening       String?  @db.VarChar(200)
  attachmentPkwt     String?  @db.VarChar(500)

  // Kontak & atasan
  emailKantor        String   @unique @db.VarChar(200)
  namaAtasan         String?  @db.VarChar(200)
  emailAtasan        String?  @db.VarChar(200)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leaveQuotas        LeaveQuota[]
  leaveRequests      LeaveRequest[]

  @@map("employees")
}

model LeaveQuota {
  id             Int      @id @default(autoincrement())
  nik            String   @db.VarChar(50)
  employee       Employee @relation(fields: [nik], references: [nik])
  tahun          Int
  jumlahCuti     Int      @default(12)
  cutiTerpakai   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leaveRequests  LeaveRequest[]

  @@unique([nik, tahun])
  @@map("leave_quotas")
}

model LeaveRequest {
  id                 Int      @id @default(autoincrement())
  requestNo          String   @unique @db.VarChar(50)
  nik                String   @db.VarChar(50)
  employee           Employee @relation(fields: [nik], references: [nik])
  quotaId            Int
  quota              LeaveQuota @relation(fields: [quotaId], references: [id])
  
  jenisCuti          String   @default("TAHUNAN") @db.VarChar(30)
  tanggalPengajuan   DateTime @default(now())
  jumlahHari         Int
  alasan             String   @db.Text
  attachmentUrl      String?  @db.VarChar(500)
  status             String   @default("PENDING_ATASAN") @db.VarChar(30)

  approvedByAtasan   String?  @db.VarChar(100)
  approvedAtAtasan   DateTime?
  catatanAtasan      String?  @db.Text
  approvedByHr       String?  @db.VarChar(100)
  approvedAtHr       DateTime?
  catatanHr          String?  @db.Text
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  details            LeaveRequestDetail[]

  @@map("leave_requests")
}

model LeaveRequestDetail {
  id              Int          @id @default(autoincrement())
  leaveRequestId  Int
  leaveRequest    LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  tanggal         DateTime     @db.Date

  @@map("leave_request_details")
}

model NationalHoliday {
  id            Int      @id @default(autoincrement())
  tanggal       DateTime @unique
  keterangan    String   @db.VarChar(200)
  tahun         Int
  isCutiBersama Boolean  @default(false)

  @@map("national_holidays")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  tableName   String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  description String   @db.Text
  oldData     Json?
  newData     Json?
  executedBy  String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

// ─────────────────────────────────────────
// TABEL AUTH: users
// ─────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  role      String   @default("STAFF") @db.VarChar(20) // SUPERADMIN, HR_ADMIN, SUPERVISOR, STAFF
  nik       String?  @unique @db.VarChar(50)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
